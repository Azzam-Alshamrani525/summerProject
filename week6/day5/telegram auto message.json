      "parameters": {
        "jsCode": "const html = $input.first().json.data;\n\n// Try pattern 1: the JSON blob embedded in most channel/video pages\nlet match = html.match(/\"channelId\":\"(UC[a-zA-Z0-9_-]{22})\"/);\n\n// Try pattern 2: the canonical link tag (more reliable across page types)\nif (!match) {\n  match = html.match(/youtube\\.com\\/channel\\/(UC[a-zA-Z0-9_-]{22})/);\n}\n\nif (!match) {\n  throw new Error(\"Could not find a channel ID in the page HTML\");\n}\n\nconst channelId = match[1];\n\nconst titleMatch = html.match(/<title>(.*?)<\\/title>/);\nconst channelName = titleMatch\n  ? titleMatch[1].replace(/ - YouTube$/, '')\n  : 'Unknown channel';\n\nreturn [{\n  json: {\n    channelId,\n    channelName,\n    rssUrl: `https://www.youtube.com/feeds/videos.xml?channel_id=${channelId}`\n  }\n}];"
      },
